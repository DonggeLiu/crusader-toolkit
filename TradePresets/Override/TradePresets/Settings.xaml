<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Margin="16">
  <TextBlock Text="Trade Presets" Foreground="White" FontSize="22" Margin="0,0,0,16" TextWrapping="Wrap"/>
  <CheckBox Content="Apply saved trade thresholds to new games" IsChecked="{Binding Enabled, Mode=TwoWay}" Foreground="White" Margin="0,0,0,16"/>
  <TextBlock Text="Applies saved buy/sell thresholds on a new game; auto-trade remains off until you turn it on in the market. Samples threshold changes during play and saves changed values when leaving the map or game. The last few seconds may not be captured. Loading a save preserves that save’s thresholds instead of overwriting them. Defaults include buying wood below 30 and hops below 2; review all values in the config before use. New-game application is enabled by default. Buy and Sell sections store presets (0 = never buy, 1000 = never sell). Disabling application does not stop learning threshold changes. Disabled in multiplayer." Foreground="#DDCC88" TextWrapping="Wrap"/>
  <StackPanel Orientation="Horizontal" Margin="0,16,0,12">
    <Button Content="Workshop / Feedback" Command="{Binding OpenWorkshop}" Padding="10,4" Margin="0,0,12,0"/>
    <Button Content="Support on Ko-fi" Command="{Binding OpenKoFi}" Visibility="{Binding KoFiVisibility}" Padding="10,4" Margin="0,0,12,0"/>
    <Button Content="Support on Afdian" Command="{Binding OpenAfdian}" Visibility="{Binding AfdianVisibility}" Padding="10,4"/>
  </StackPanel>
  <TextBlock Text="By Dongge · MIT License. Thanks to Rawra for SHCDE Script Extender and Workshop tools, and the BepInEx and Harmony contributors." Foreground="#DDCC88" TextWrapping="Wrap"/>
</StackPanel>
