<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Margin="16">
  <TextBlock Text="Stock Delta" Foreground="White" FontSize="22" Margin="0,0,0,16" TextWrapping="Wrap"/>
  <CheckBox Content="Show net stock changes in storage panels" IsChecked="{Binding Enabled, Mode=TwoWay}" Foreground="White" Margin="0,0,0,16"/>
  <TextBlock Text="Adds signed net changes below stockpile, granary food-report and armoury counts. Large number: previous game month. Small number after the dot: this month so far. Green means gain; red means loss. Includes all stock changes, including trade and consumption; it is not a production-only statistic. Statistics restart on a new game or load. A dash means no previous interval is available; the first interval after loading may be a partial month. Enabled by default. Works independently. With Granary Overview, that mod supplies its own granary totals; Stock Delta still covers the other storage/report panels." Foreground="#DDCC88" TextWrapping="Wrap"/>
  <StackPanel Orientation="Horizontal" Margin="0,16,0,12">
    <Button Content="Workshop / Feedback" Command="{Binding OpenWorkshop}" Padding="10,4" Margin="0,0,12,0"/>
    <Button Content="Support on Ko-fi" Command="{Binding OpenKoFi}" Visibility="{Binding KoFiVisibility}" Padding="10,4" Margin="0,0,12,0"/>
    <Button Content="Support on Afdian" Command="{Binding OpenAfdian}" Visibility="{Binding AfdianVisibility}" Padding="10,4"/>
  </StackPanel>
  <TextBlock Text="By Dongge · MIT License. Thanks to Rawra for SHCDE Script Extender and Workshop tools, and the BepInEx and Harmony contributors." Foreground="#DDCC88" TextWrapping="Wrap"/>
</StackPanel>
